<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RomanNumeralConverter.MainPage" Title="Roman Numeral Converter">
    <StackLayout Padding="20,20">
        <Border Stroke="Gray" StrokeThickness="1">
            <Entry x:Name="txtInput" Text="5" FontSize="20" />
        </Border>
        <Label HorizontalTextAlignment="Center" x:Name="lblOutput" Text="V" FontSize="Title" Padding="0,40,0,80"/>
        <Button Text="Convert" Clicked="Button_OnClicked"/>
    </StackLayout>
    
</ContentPage>